{
  "name": "@jj/runner-daemon",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run src --testTimeout 60000",
    "test:integration": "JJ_RUN_TEMPORAL_INTEGRATION=1 vitest run src/exit-test.integration.test.ts --testTimeout 60000",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@jj/core": "workspace:*",
    "@jj/policy": "workspace:*",
    "@jj/runner-claude": "workspace:*",
    "@jj/runner-gemini": "workspace:*",
    "@jj/runner-mock": "workspace:*",
    "@jj/runner-openai": "workspace:*",
    "@jj/ingest": "workspace:*",
    "@jj/workflows": "workspace:*",
    "@temporalio/activity": "^1.11.5",
    "@temporalio/worker": "^1.11.5"
  },
  "devDependencies": {
    "@temporalio/client": "^1.11.5",
    "vitest": "^2.1.8"
  }
}
