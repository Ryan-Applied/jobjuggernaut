# Shared
DATABASE_URL=postgres://jj:jj@localhost:5440/jj
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
API_URL=http://localhost:4000

# Runner daemon (local only; never set these in the cloud)
RUNNER_ID=laptop
RUNNER_TASK_QUEUE=local-laptop
RUNNER_API_TOKEN=dev-token
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
WORKTREE_ROOT=./.worktrees

# API
API_PORT=4000
API_INGEST_TOKENS=dev-token

# Policy and approvals
LEDGER_SIGNING_SECRET=change-me            # HMAC key for ledger signatures (WebAuthn later)
JJ_TZ=Europe/London
JJ_OVERNIGHT_CRON=0 22 * * *               # overnight batch
JJ_LEARN_CRON=0 3 * * *                    # nightly proposals
JJ_INTERNAL_EMAIL_DOMAIN=@appliedcomputing.com

# Slack approvals (optional). Bot needs chat:write; interactivity URL -> {API_URL}/slack/interactions
SLACK_BOT_TOKEN=
SLACK_APPROVALS_CHANNEL=
SLACK_SIGNING_SECRET=

# Indexer (optional; falls back to an offline hash embedder)
VOYAGE_API_KEY=
