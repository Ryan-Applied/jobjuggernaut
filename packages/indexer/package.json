{
  "name": "@jj/indexer",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --testTimeout 60000",
    "test:integration": "JJ_RUN_INDEXER_INTEGRATION=1 vitest run src/indexer.test.ts --testTimeout 60000"
  },
  "dependencies": {
    "@jj/core": "workspace:*",
    "@jj/graph": "workspace:*",
    "drizzle-orm": "^0.36.4"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
